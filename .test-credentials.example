# Platterhead — UI regression suite credentials (TEMPLATE)
#
# Copy to `.test-credentials` and fill in. That file is gitignored and MUST NEVER
# be committed. This template is committed; it carries key names only, no values.
#
#   cp .test-credentials.example .test-credentials
#   make test-ui-regression
#
# Format: INI-style sections, `key = value`, `#` comments. Values are not quoted.
# Any section left blank causes its regression lane to SKIP with a stated reason,
# never to fail — a missing credential is not a product defect (§53.4).

[archive.org]
# Public lanes (D-9, D-15) need no credentials — they use "The Vapor Vault".
# This section is only for the private-list lane (D-16).
username =
password =
list_url =

[subsonic-local]
# Your own Navidrome/Subsonic server, if you have one. The public demo below is
# used when this is blank, so this section is optional.
url =
username =
password =

[plex]
# Plex requires a claim token to bind a local server; get one (valid 4 minutes)
# from https://www.plex.tv/claim while signed in. See §54.3.
claim_token =
server_url =
username =
password =

[jellyfin-local]
# Optional. The public demo at https://demo.jellyfin.org/stable is the default
# fixture and needs only user "demo" with an EMPTY password (D-13).
url =
username =
password =

[cloud-oauth]
# Dropbox / Google Drive / OneDrive / pCloud (D-17). Each needs an app
# registration you create; see docs/plans/remote-oauth-connectors-handoff.md.
# Leave blank until those exist — the lanes skip.
dropbox_app_key =
google_drive_client_id =
onedrive_client_id =
pcloud_client_id =
