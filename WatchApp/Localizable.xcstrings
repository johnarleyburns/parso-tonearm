          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "このiPhoneには別のミュージックライブラリがあります。置き換えるとこのWatchは同期されたままになりますが、そこにないダウンロードは削除されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
