    "This iPhone has a different music library. Replacing keeps this watch in sync but removes downloads that are no longer in it." : {
      "comment" : "UI text shown in: Platterhead Watch App (WatchApp/PlatterheadWatchApp.swift)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dieses iPhone hat eine andere Musikbibliothek. Beim Ersetzen bleibt diese Watch synchron, aber Downloads, die dort nicht mehr vorhanden sind, werden entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This iPhone has a different music library. Replacing keeps this watch in sync but removes downloads that are no longer in it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Este iPhone tiene otra biblioteca de música. Al reemplazar, este reloj se mantiene sincronizado, pero se eliminan las descargas que ya no estén en ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
