        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "認証情報は不要です。Platterheadは公開のクリエイティブ・コモンズのカタログを読み込み、すべての曲にクレジット表記を保持します。"
          }
        },
        "pt-BR" : {
