    "Pick the genres you want to mix. Each one becomes its own library, ordered by what's most interesting right now — so you can build a set from techno without wading through everything else." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wähle die Genres, die du mixen möchtest. Jedes wird zu einer eigenen Bibliothek, sortiert nach dem, was gerade am spannendsten ist – so baust du ein Set aus Techno, ohne dich durch alles andere zu wühlen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elige los géneros que quieres mezclar. Cada uno será su propia biblioteca, ordenada por lo más interesante del momento, para que puedas montar una sesión de techno sin rebuscar entre todo lo demás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Choisissez les genres que vous voulez mixer. Chacun devient sa propre bibliothèque, classée selon ce qui est le plus intéressant en ce moment – pour construire un set techno sans fouiller dans tout le reste."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ミックスしたいジャンルを選んでください。それぞれが独立したライブラリになり、いま注目の順に並びます。ほかのジャンルをかき分けずにテクノのセットを組めます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Escolha os gêneros que quer mixar. Cada um vira sua própria biblioteca, ordenada pelo que está mais interessante agora — assim você monta um set de techno sem ter que vasculhar todo o resto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "选择你想混音的风格。每种风格都会成为独立的资料库，按当下最有趣的顺序排列——这样你就能组建一套铁克诺，而不必翻遍其他内容。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick the genres you want to mix. Each one becomes its own library, ordered by what's most interesting right now — so you can build a set from techno without wading through everything else."
          }
        }
      },
      "comment" : "UI text shown in: Genre Picker (Sources/Features/Ingest/GenrePickerView.swift)"
    },
