    "Each track stays within 8% of the last one's tempo, in a matching key." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jeder Titel bleibt innerhalb von 8 % des Tempos des vorherigen, in einer passenden Tonart."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each track stays within 8% of the last one's tempo, in a matching key."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cada pista se mantiene a menos del 8 % del tempo de la anterior, en una tonalidad compatible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chaque morceau reste à moins de 8 % du tempo du précédent, dans une tonalité compatible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "各曲は前の曲のテンポから8%以内、相性の良いキーで続きます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cada faixa fica a até 8% do andamento da anterior, em um tom compatível."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "每首曲目的速度与上一首相差不超过 8%，调性相互匹配。"
          }
        }
      }
    },
