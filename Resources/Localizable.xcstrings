    "No credentials needed. Platterhead reads the public Creative-Commons catalogue and keeps attribution with every track." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Keine Zugangsdaten nötig. Platterhead liest den öffentlichen Creative-Commons-Katalog und behält bei jedem Titel die Namensnennung bei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No credentials needed. Platterhead reads the public Creative-Commons catalogue and keeps attribution with every track."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No hacen falta credenciales. Platterhead lee el catálogo público Creative Commons y conserva la atribución de cada pista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aucun identifiant nécessaire. Platterhead lit le catalogue public Creative Commons et conserve l’attribution de chaque morceau."
