          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tengo una cuenta del catálogo (opcional): al iniciar sesión se añaden tus favoritos y playlists. **Explorar y reproducir funcionan sin ella.**"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
