// Copy to Config/Secrets.xcconfig and fill in. That file is gitignored.
// Key names only here — never a value (§54.2).
//
// Register an application at https://devportal.jamendo.com to get a client id.
// It is an APPLICATION credential, not a user login: FR-LIB-9's "works with no
// account" is unaffected. Users may also supply their own in Settings, which
// takes precedence over this one.

TONEARM_JAMENDO_CLIENT_ID =

// Cloud-drive OAuth: Dropbox, Google Drive, OneDrive and pCloud each need their
// own application registered in that provider's own developer console
// (Dropbox App Console / Google Cloud Console / Azure AD app registrations /
// pCloud API console), with a redirect URI of tonearm://oauth/<provider>
// (dropbox, oneDrive, pCloud). Without a real client ID here,
// AddServerSheet's Sign In fails immediately with "OAuth is not configured for
// <provider>" (Sources/Remote/OAuthCore.swift's invalidClientConfiguration) —
// that error is accurate, not a bug: these four are blocked on app
// registrations only the account owner can create (see
// RemoteLibraryRegressionUITests.swift's D-17 comment, which documents the
// same gap for its own cloud-drive regression lane).
TONEARM_DROPBOX_CLIENT_ID =
// Google Drive is the exception: Google's "iOS" OAuth client type has no free-text redirect
// field — it ties the redirect to a reversed-client-ID scheme instead (derived from the Client
// ID: strip ".apps.googleusercontent.com" and prepend "com.googleusercontent.apps."). That
// derived scheme is hardcoded in project.yml's CFBundleURLTypes and in
// OAuthClientConfiguration.swift's googleDriveReversedClientID — NOT read from this file —
// because Xcode's Info.plist $(VAR) substitution silently collapses to a 1-character garbage
// value for a string nested this deep (array > dict > array > string), confirmed against real
// archived builds. If the Google Drive OAuth app is ever re-created, update both those literals.
TONEARM_GOOGLE_DRIVE_CLIENT_ID =
TONEARM_ONEDRIVE_CLIENT_ID =
TONEARM_PCLOUD_CLIENT_ID =
// pCloud is the one provider here needing a client *secret* too (its OAuth
// token exchange is confidential-client, not PKCE-only like the other three).
TONEARM_PCLOUD_CLIENT_SECRET =

// Box — register at https://account.box.com/developers/console, redirect URI
// tonearm://oauth/box. Box's OAuth token endpoint has no PKCE support (no
// code_verifier/code_challenge field), so like pCloud it needs a real client
// *secret*, not just a client ID.
TONEARM_BOX_CLIENT_ID =
TONEARM_BOX_CLIENT_SECRET =

// Yandex.Disk — register at https://oauth.yandex.com, redirect URI
// tonearm://oauth/yandexDisk. Confirm at registration time whether Yandex ID
// supports a public/PKCE client (no secret needed) or only a confidential
// client; fill in the secret below only if it's required.
TONEARM_YANDEX_CLIENT_ID =
TONEARM_YANDEX_CLIENT_SECRET =
